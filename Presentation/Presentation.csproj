<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
	<AssemblyName>LinCtrlApi</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sudzekai.LinCtrl.Hosting" Version="0.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.5" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="MySql.Data" />
    <TrimmerRootAssembly Include="System.Configuration.ConfigurationManager" />
  </ItemGroup>
  
</Project>
